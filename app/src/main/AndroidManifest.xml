<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TunaApp"
        android:label="吐纳 Tuna"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Tuna"
        android:supportsRtl="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Calm Now: no back stack, single task, launched fresh from widget/tile -->
        <activity
            android:name=".CalmNowActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <!-- Owns the running session so it survives screen-off / activity teardown -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Home-screen widget -->
        <receiver
            android:name=".CalmNowWidgetReceiver"
            android:exported="true"
            android:label="吐纳 Calm Now">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calm_now_widget_info" />
        </receiver>

        <!-- Quick-settings tile -->
        <service
            android:name=".CalmNowTileService"
            android:exported="true"
            android:label="吐纳 Calm Now"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>

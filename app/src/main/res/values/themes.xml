<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tuna" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <!-- Light icons on the dark bars (the parent is a light theme, which would paint black icons) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
